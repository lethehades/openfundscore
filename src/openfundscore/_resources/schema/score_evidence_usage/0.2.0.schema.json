{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfundscore.org/schemas/score_evidence_usage/0.2.0.schema.json",
  "title": "OpenFundScore Score Evidence Usage Record 0.2.0",
  "description": "Point-in-time ledger of evidence actually consumed by one score record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score_record_id",
    "model_version",
    "fund_strategy_id",
    "category_profile",
    "as_of",
    "usage"
  ],
  "properties": {
    "score_record_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "fund_strategy_id": {"type": "string", "minLength": 1},
    "category_profile": {
      "enum": [
        "active_equity_mixed",
        "fixed_income_plus",
        "index_etf",
        "bond",
        "money_market",
        "qdii_active",
        "qdii_index",
        "fof_pension",
        "gold_commodity",
        "public_reit"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "usage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/usage"}
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_role",
        "lineage_id",
        "series_id",
        "evidence_family",
        "target_component",
        "source_scope",
        "usage_mode",
        "observation_as_of",
        "window_basis",
        "window_months",
        "window_start",
        "window_end"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_role": {"enum": ["primary", "capture_denominator"]},
        "benchmark_downside_sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "lineage_id": {"type": "string", "minLength": 1},
        "series_id": {"type": "string", "minLength": 1},
        "source_facts_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_family": {"type": "string", "minLength": 1},
        "target_component": {
          "enum": [
            "fund_d1_performance_evidence",
            "fund_d2_downside_risk",
            "fund_d3_consistency",
            "fund_d4_manager_capability",
            "fund_d5_portfolio_structure",
            "fund_d6_implementation_efficiency",
            "fund_d7_governance_operations",
            "manager_tenure_attributed_performance",
            "manager_downside_control",
            "manager_cross_cycle_consistency",
            "manager_style_discipline",
            "manager_career_track_record",
            "manager_workload_capacity",
            "manager_research_platform_team",
            "manager_compliance_integrity"
          ]
        },
        "source_scope": {
          "enum": ["current_fund", "external_career", "team_platform"]
        },
        "usage_mode": {
          "enum": ["raw", "residualized", "orthogonal", "descriptive"]
        },
        "observation_as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        },
        "window_basis": {
          "enum": ["point_in_time", "calendar_months", "actual_dates"]
        },
        "window_months": {"type": "integer", "minimum": 0, "maximum": 1200},
        "window_start": {"type": "string", "format": "date"},
        "window_end": {"type": "string", "format": "date"}
      },
      "oneOf": [
        {
          "properties": {
            "evidence_role": {"const": "primary"},
            "target_component": {
              "enum": [
                "manager_tenure_attributed_performance",
                "manager_downside_control",
                "manager_cross_cycle_consistency",
                "manager_style_discipline",
                "manager_career_track_record",
                "manager_workload_capacity",
                "manager_research_platform_team",
                "manager_compliance_integrity"
              ]
            }
          },
          "required": ["source_facts_sha256"],
          "not": {"required": ["benchmark_downside_sample_count"]}
        },
        {
          "properties": {
            "evidence_role": {"const": "primary"},
            "target_component": {
              "enum": [
                "fund_d1_performance_evidence",
                "fund_d2_downside_risk",
                "fund_d3_consistency",
                "fund_d4_manager_capability",
                "fund_d5_portfolio_structure",
                "fund_d6_implementation_efficiency",
                "fund_d7_governance_operations"
              ]
            }
          },
          "not": {
            "anyOf": [
              {"required": ["benchmark_downside_sample_count"]},
              {"required": ["source_facts_sha256"]}
            ]
          }
        },
        {
          "properties": {
            "evidence_role": {"const": "capture_denominator"},
            "target_component": {
              "enum": [
                "fund_d1_performance_evidence",
                "fund_d2_downside_risk",
                "fund_d3_consistency",
                "fund_d4_manager_capability",
                "fund_d5_portfolio_structure",
                "fund_d6_implementation_efficiency",
                "fund_d7_governance_operations"
              ]
            }
          },
          "required": ["benchmark_downside_sample_count"],
          "not": {"required": ["source_facts_sha256"]}
        }
      ]
    }
  }
}
