{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfundscore.org/schemas/provider_record/0.2.0.schema.json",
  "title": "OpenFundScore Provider Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "namespace",
    "source_type",
    "jurisdiction",
    "entity_type",
    "entity_id",
    "exact_identifiers",
    "field",
    "value",
    "as_of",
    "published_at",
    "fetched_at",
    "source_url",
    "point_in_time_status",
    "quality_state",
    "rights",
    "effective_status"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "provider_record_id": {
      "type": "string",
      "maxLength": 256
    },
    "namespace": {
      "enum": [
        "canonical_observation",
        "external_ratings"
      ]
    },
    "source_type": {
      "enum": [
        "regulator",
        "exchange",
        "official_registry",
        "fund_company_or_manager",
        "custodian",
        "index_or_macro_official_source",
        "commercial_vendor",
        "distribution_platform",
        "user_import"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "entity_type": {
      "enum": [
        "fund_strategy",
        "share_class",
        "manager",
        "manager_tenure",
        "benchmark",
        "holding",
        "issuer",
        "platform_listing",
        "report",
        "corporate_action",
        "external_rating"
      ]
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "methodology": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 65536
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 64
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 64
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "source_document_hash": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "point_in_time_status": {
      "enum": [
        "verified",
        "provider_claimed",
        "reconstructed",
        "not_point_in_time",
        "unknown"
      ]
    },
    "quality_state": {
      "enum": [
        "verified",
        "unverified",
        "stale",
        "conflict",
        "missing",
        "not_applicable"
      ]
    },
    "conflict_group": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "cache_allowed",
        "derived_works_allowed",
        "redistribution_allowed",
        "attribution_required",
        "public_display_allowed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "open_redistributable",
            "derived_only",
            "local_entitlement",
            "display_only",
            "unknown_blocked"
          ]
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "cache_allowed": {
          "type": "boolean"
        },
        "derived_works_allowed": {
          "type": "boolean"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "attribution_required": {
          "type": "boolean"
        },
        "public_display_allowed": {
          "type": "boolean"
        },
        "retention_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 36500
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "unknown_blocked"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "cache_allowed": {
                "const": false
              },
              "derived_works_allowed": {
                "const": false
              },
              "redistribution_allowed": {
                "const": false
              },
              "attribution_required": {
                "const": false
              },
              "public_display_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "derived_only"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "derived_works_allowed": {
                "const": true
              },
              "redistribution_allowed": {
                "const": false
              },
              "public_display_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "display_only"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "cache_allowed": {
                "const": false
              },
              "derived_works_allowed": {
                "const": false
              },
              "redistribution_allowed": {
                "const": false
              },
              "public_display_allowed": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "local_entitlement"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "redistribution_allowed": {
                "const": false
              },
              "public_display_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "open_redistributable"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "redistribution_allowed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "exact_identifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exact_identifier"
      }
    },
    "effective_status": {
      "enum": [
        "current",
        "future",
        "expired"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entity_type": {
            "const": "external_rating"
          }
        },
        "required": [
          "entity_type"
        ]
      },
      "then": {
        "properties": {
          "namespace": {
            "const": "external_ratings"
          }
        }
      },
      "else": {
        "properties": {
          "namespace": {
            "const": "canonical_observation"
          }
        }
      }
    }
  ],
  "$defs": {
    "exact_identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "value",
        "jurisdiction"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "cn_fund_code",
            "csrc_registration_id",
            "exchange_security_code",
            "fund_company_official_id",
            "official_document_id",
            "official_entity_id"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "jurisdiction": {
          "const": "CN"
        }
      }
    }
  }
}
